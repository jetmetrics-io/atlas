# Выгрузка приложения. Не исходник: собирается из Базы командой `npm run gen`
# (scripts/build_app.py). Правда лежит в db/atlas.sql, и правится База, а не эти файлы.
public/data/

# Рабочая копия Базы. В git её нет намеренно: двоичный файл не показывает,
# что изменилось, и молча затирает чужие правки при слиянии. В репозитории
# лежит текстовый дамп db/atlas.sql, база собирается из него: `npm run db`.
db/atlas.db
db/*.before_*.db
db/*.check.sql

